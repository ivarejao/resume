@article{VAREJAO2025112822,
title = {The similarity bias problem: What it is and how it impacts vibration based intelligent fault diagnosis},
journal = {Mechanical Systems and Signal Processing},
volume = {235},
pages = {112822},
year = {2025},
issn = {0888-3270},
doi = {https://doi.org/10.1016/j.ymssp.2025.112822},
url = {https://www.sciencedirect.com/science/article/pii/S0888327025005230},
author = {Igor Mattos dos Santos Varejão and Lucas Gabriel de Oliveira Costa and Luciano Henrique Peixoto da Silva and Alexandre Rodrigues and Marcos Pellegrini Ribeiro and Flávio Miguel Varejão and Thiago Oliveira-Santos},
keywords = {Machine learning, Similarity bias, Fault diagnosis, Vibration analysis},
abstract = {This study investigates the impact of similarity bias in machine learning research focused on vibration data for intelligent fault diagnosis. Conducting experiments on publicly available vibration datasets, the research compares performance between conventional and deep learning models under a cross-validation strategy, addressing the similarity bias issue. Three classification models are employed, two incorporating statistical feature extraction and shallow learning techniques, and other using a deep convolutional neural network. Results reveal that similarity bias leads to overestimated performance in the three models. The contributions of this work include raising awareness about the similarity bias problem, designing experiments on public datasets that mitigate its effects, validating its impact, providing code, benchmark methods and results for future research and also presenting a list of recommendations for using vibration based datasets in machine learning research. The paper details methods, datasets, and evaluation metrics, concluding with insights and directions for future work.}
}


